@{
    ViewData["Title"] = "Home";
}

<div class="text-center py-4">
    <h1 class="display-4 fw-bold text-success">Welcome to Lanigay High School</h1>
    <p class="lead">Empowering students through quality secondary education</p>
    <hr />
</div>

<h3 class="mb-4">Senior High School Subjects</h3>

<div class="row row-cols-1 row-cols-md-3 g-4">
    <div class="col">
        <div class="card h-100 border-primary">
            <div class="card-header bg-primary text-white">STEM</div>
            <div class="card-body">
                <h5 class="card-title">General Mathematics</h5>
                <p class="card-text">Functions, calculus, and problem-solving for senior high school.</p>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100 border-primary">
            <div class="card-header bg-primary text-white">STEM</div>
            <div class="card-body">
                <h5 class="card-title">Pre-Calculus</h5>
                <p class="card-text">Advanced algebra and trigonometry foundations.</p>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100 border-primary">
            <div class="card-header bg-primary text-white">STEM</div>
            <div class="card-body">
                <h5 class="card-title">Basic Calculus</h5>
                <p class="card-text">Limits, derivatives, and integrals for STEM students.</p>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100 border-success">
            <div class="card-header bg-success text-white">Science</div>
            <div class="card-body">
                <h5 class="card-title">General Biology</h5>
                <p class="card-text">Cell biology, genetics, and ecology.</p>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100 border-success">
            <div class="card-header bg-success text-white">Science</div>
            <div class="card-body">
                <h5 class="card-title">General Chemistry</h5>
                <p class="card-text">Atomic structure, chemical bonding, and reactions.</p>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100 border-success">
            <div class="card-header bg-success text-white">Science</div>
            <div class="card-body">
                <h5 class="card-title">General Physics</h5>
                <p class="card-text">Mechanics, thermodynamics, and electromagnetism.</p>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100 border-warning">
            <div class="card-header bg-warning text-dark">HUMSS</div>
            <div class="card-body">
                <h5 class="card-title">Philippine Politics & Governance</h5>
                <p class="card-text">Government structure and civic engagement.</p>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100 border-warning">
            <div class="card-header bg-warning text-dark">HUMSS</div>
            <div class="card-body">
                <h5 class="card-title">Creative Writing</h5>
                <p class="card-text">Fiction, poetry, and literary techniques.</p>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100 border-info">
            <div class="card-header bg-info text-white">ABM</div>
            <div class="card-body">
                <h5 class="card-title">Business Mathematics</h5>
                <p class="card-text">Financial math and business statistics.</p>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100 border-info">
            <div class="card-header bg-info text-white">ABM</div>
            <div class="card-body">
                <h5 class="card-title">Fundamentals of Accountancy</h5>
                <p class="card-text">Basic accounting principles and bookkeeping.</p>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100 border-secondary">
            <div class="card-header bg-secondary text-white">Core</div>
            <div class="card-body">
                <h5 class="card-title">English for Academic Purposes</h5>
                <p class="card-text">Academic reading, writing, and research skills.</p>
            </div>
        </div>
    </div>
    <div class="col">
        <div class="card h-100 border-secondary">
            <div class="card-header bg-secondary text-white">Core</div>
            <div class="card-body">
                <h5 class="card-title">21st Century Literature</h5>
                <p class="card-text">Contemporary Philippine and world literature.</p>
            </div>
        </div>
    </div>
</div>

<div class="row mt-4">
    <div class="col-md-6">
        <div class="card bg-success text-white">
            <div class="card-body">
                <h5 class="card-title">Learning Accessibility</h5>
                <p class="card-text">Access subjects anytime, anywhere through our digital platform.</p>
            </div>
        </div>
    </div>
    <div class="col-md-6">
        <div class="card bg-info text-white">
            <div class="card-body">
                <h5 class="card-title">Performance Monitoring</h5>
                <p class="card-text">Track grades, attendance, and progress in real-time.</p>
            </div>
        </div>
    </div>
</div>