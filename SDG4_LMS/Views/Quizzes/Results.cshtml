@model SDG4_LMS.Models.ViewModels.QuizResultViewModel
@{
    ViewData["Title"] = "Quiz Results";
}

<h1><i class="fas fa-clipboard-check me-2"></i>Quiz Results</h1>

<div class="card mb-4 @(Model.IsPassed ? "border-success" : "border-danger") shadow">
    <div class="card-header text-white @(Model.IsPassed ? "bg-success" : "bg-danger")">
        <h4 class="mb-0">@Model.QuizTitle</h4>
    </div>
    <div class="card-body text-center">
        <h1 class="display-2 fw-bold">@Model.Score%</h1>
        <p class="lead">@Model.TotalPoints total points possible</p>
        <p><i class="fas fa-clock me-1"></i>Time taken: @Model.TimeTaken</p>
        @if (Model.IsPassed)
        {
            <span class="badge bg-success fs-3 px-4 py-2"><i class="fas fa-check-circle me-2"></i>PASSED</span>
        }
        else
        {
            <span class="badge bg-danger fs-3 px-4 py-2"><i class="fas fa-times-circle me-2"></i>FAILED</span>
        }
        <p class="text-muted mt-3">Passing score: @Model.PassingScore%</p>
    </div>
</div>

<h3><i class="fas fa-search me-2"></i>Answer Review</h3>
@foreach (var a in Model.Answers)
{
    <div class="card mb-3 @(a.IsCorrect ? "border-success" : "border-danger")">
        <div class="card-body">
            <h6 class="fw-bold mb-3">@a.QuestionText</h6>
            <div class="row align-items-center">
                <div class="col-md-4">
                    Your answer:
                    <strong class="@(a.IsCorrect ? "text-success" : "text-danger")">@a.SelectedAnswer</strong>
                </div>
                <div class="col-md-4">
                    @if (!a.IsCorrect)
                    {
                        <span>Correct: <strong class="text-success">@a.CorrectAnswer</strong></span>
                    }
                    else
                    {
                        <span class="text-success"><i class="fas fa-check me-1"></i>Correct!</span>
                    }
                </div>
                <div class="col-md-4 text-md-end">
                    <span class="badge @(a.IsCorrect ? "bg-success" : "bg-secondary")">
                        @(a.IsCorrect ? "+" : "0") @a.Points pts
                    </span>
                </div>
            </div>
        </div>
    </div>
}

<div class="mb-5">
    <a asp-controller="Students" asp-action="Dashboard" class="btn btn-primary">
        <i class="fas fa-arrow-left me-2"></i>Back to Dashboard
    </a>
</div>
