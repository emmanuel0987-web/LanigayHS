@model SDG4_LMS.Models.Quiz
@{
    ViewData["Title"] = Model.Title;
}

<h1><i class="fas fa-question-circle me-2"></i>@Model.Title</h1>
<p class="text-muted">@Model.Description</p>

<div class="row mb-4">
    <div class="col-md-4">
        <div class="card text-center">
            <div class="card-body">
                <h5>Time Limit</h5>
                <p class="fs-3 fw-bold text-primary">@Model.TimeLimitMinutes min</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center">
            <div class="card-body">
                <h5>Passing Score</h5>
                <p class="fs-3 fw-bold text-success">@Model.PassingScore%</p>
            </div>
        </div>
    </div>
    <div class="col-md-4">
        <div class="card text-center">
            <div class="card-body">
                <h5>Total Questions</h5>
                <p class="fs-3 fw-bold text-info">@Model.Questions.Count / 20</p>
            </div>
        </div>
    </div>
</div>

@if (User.IsInRole("Teacher") || User.IsInRole("Admin"))
{
    <div class="mb-3">
        <a asp-controller="QuizQuestions" asp-action="Create" asp-route-quizId="@Model.Id" class="btn btn-success">
            <i class="fas fa-plus me-2"></i>Add Questions (@(20 - Model.Questions.Count) remaining)
        </a>
        <a asp-controller="Courses" asp-action="Details" asp-route-id="@Model.CourseId" class="btn btn-outline-secondary">Back to Course</a>
    </div>
}

@if (User.IsInRole("Student"))
{
    <div class="mb-3">
        <a asp-action="Take" asp-route-id="@Model.Id" class="btn btn-primary btn-lg">
            <i class="fas fa-play me-2"></i>Take Quiz
        </a>
    </div>
}

<h3 class="mt-4">Questions Preview</h3>
@if (Model.Questions.Any())
{
    <div class="list-group">
        @foreach (var q in Model.Questions)
        {
            <div class="list-group-item">
                <p class="fw-bold mb-2">@q.QuestionText</p>
                <div class="row text-muted small">
                    <div class="col-md-3">A. @q.OptionA</div>
                    <div class="col-md-3">B. @q.OptionB</div>
                    <div class="col-md-3">C. @q.OptionC</div>
                    <div class="col-md-3">D. @q.OptionD</div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="alert alert-info">No questions added yet.</div>
}
